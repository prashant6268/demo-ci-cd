  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "Main",
      "image": "738759745415.dkr.ecr.us-east-1.amazonaws.com/demo1",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512"
